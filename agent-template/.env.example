# --- Agent Template Local Testing ---
# Port for local development (Cloud Run uses 8080 by default)
PORT=8080

# Mock Agent ID for local testing (Injected by Control Plane in production)
AGENT_ID="local-dev-agent"

# Gemini API Key for local testing (In production, fetched securely from WorkOS vault)
GEMINI_API_KEY="your-gemini-api-key"
